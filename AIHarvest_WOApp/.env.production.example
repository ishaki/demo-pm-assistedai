# ===========================
# DOCKER COMPOSE PROJECT NAME
# ===========================
# Compose names volumes and networks after the project, which defaults to this
# directory's name: AIHarvest_WOApp -> aiharvest_woapp, giving the n8n volume
# aiharvest_woapp_n8n_data.
#
# This directory used to be Dyson_WOApp, so an existing deployment's n8n data
# sits in dyson_woapp_n8n_data. Leaving this unset points Compose at a NEW,
# empty volume: n8n credentials, anything built in the n8n UI, and execution
# history all appear to vanish. Nothing is actually lost -- the old volume is
# untouched -- but the running app will not see any of it. (Workflow JSON is
# bind-mounted from ../AIHarvest_Workflow/workflows and is unaffected.)
#
# Uncomment ONLY when upgrading such a deployment in place; leave it off for a
# fresh install. The alternative is to copy the data across once:
#   docker run --rm -v dyson_woapp_n8n_data:/from -v aiharvest_woapp_n8n_data:/to alpine sh -c "cd /from && cp -a . /to"
# COMPOSE_PROJECT_NAME=dyson_woapp

# ===========================
# DATABASE CONFIGURATION
# ===========================
DATABASE_URL=mssql+pyodbc://username:password@server:1433/database?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Whether the backend may create missing tables on startup (create_all).
# Additive only -- it never drops or alters an existing table -- but it is still
# DDL against a live database on every restart.
#
# Leave unset (defaults to True) for a first install, so the tables appear on
# their own. Set False once the schema exists and you want the app to issue no
# schema statements at all; create tables out of band instead with:
#   docker compose -f docker-compose.prod.yml exec backend python scripts/init_db.py
#
# deploy-app.sh forces this to False regardless of what is set here, unless you
# run it with --with-db-init. deploy.sh honours this value.
# DB_AUTO_CREATE_TABLES=False

# ===========================
# LLM PROVIDER CONFIGURATION
# ===========================
# Choose EXACTLY one of: openai | claude | gemini
#
# These three strings are the keys of provider_map in
# app/services/llm_providers/__init__.py. "anthropic" and "google" are NOT
# accepted and fail at startup with "Unknown LLM provider".
LLM_PROVIDER=claude

# API Keys (only the one matching LLM_PROVIDER is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=

# Optional model override. Leave blank to use the provider default:
#   claude  -> claude-sonnet-5
#   openai  -> gpt-4
#   gemini  -> gemini-1.5-pro
#
# Do NOT pin a legacy Claude model here. The provider sends no temperature and
# reads the first text block of the response, which is what current Claude
# models require; older ones are untested against that request shape.
LLM_MODEL=

# ===========================
# AI DECISION THRESHOLDS
# ===========================
CONFIDENCE_THRESHOLD=0.7
PM_DUE_DAYS=30

# ===========================
# EMAIL CONFIGURATION
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=True

# ===========================
# APPLICATION SETTINGS
# ===========================
DEBUG=False

# ===========================
# CORS CONFIGURATION
# ===========================
# IMPORTANT: Add all domains/URLs that will access your backend
#
# Option 1: With custom domain (recommended for production)
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
#
# Option 2: With IP address
# CORS_ORIGINS=http://192.168.1.100:3000
#
# Option 3: Multiple origins (domain + IP for flexibility)
# CORS_ORIGINS=https://your-domain.com,http://192.168.1.100:3000
#
CORS_ORIGINS=http://your-test-server-ip:3000,http://your-domain.com

# ===========================
# FRONTEND CONFIGURATION
# ===========================
# CRITICAL: This URL is baked into the React build and used by the browser
# It MUST match where your backend is accessible from the internet
#
# Option 1: With custom domain (recommended)
#   - Using subdomain: https://api.your-domain.com/api/v1
#   - Using main domain with port: https://your-domain.com:8000/api/v1
#   - Using path-based routing with reverse proxy: https://your-domain.com/api/v1
#
# Option 2: With IP address (for testing)
#   - REACT_APP_API_URL=http://192.168.1.100:8000/api/v1
#
# Option 3: With HTTPS (recommended for production)
#   - REACT_APP_API_URL=https://api.your-domain.com/api/v1
#
REACT_APP_API_URL=http://your-test-server-ip:8000/api/v1

# ===========================
# N8N CONFIGURATION
# ===========================
N8N_USER=admin
N8N_PASSWORD=change-this-secure-password

# N8N Webhook URL configuration
# Option 1: With custom domain: https://n8n.your-domain.com/
# Option 2: With IP address: http://192.168.1.100:5678/
N8N_WEBHOOK_URL=http://your-test-server-ip:5678/
TIMEZONE=America/New_York

# ===========================
# DEMO RESET PAGE
# ===========================
# Backs the page at /demo-reset, reached by clicking the copyright line in the
# sidebar. The endpoint behind it DELETES every machine, work order, AI
# decision, maintenance record and workflow log, then reseeds the demo estate.
#
# DEMO_RESET_ENABLED=False makes the endpoint inert (403). Left enabled, a
# blank DEMO_RESET_TOKEN makes it refuse every request (503) rather than stand
# open -- this token is the only authentication anywhere in the application, so
# make it long and do not reuse it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_RESET_ENABLED=True
DEMO_RESET_TOKEN=change-me-before-deploying

# Defaults the reset page prefills. A reset writes these to every seeded
# machine: admin_email receives the approval notice, supplier_email the
# supplier notification.
DEMO_ADMIN_EMAIL=ishak.ahmad@innoark.com
DEMO_SUPPLIER_EMAIL=natalia4nib@gmail.com
